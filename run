#!/usr/bin/env bash
# Starts Tirith with one command: builds the daemon if needed, starts it when nothing answers on its port,
# and opens its page. The daemon keeps running after this script ends; `tirith status` shows what it does.
#   TIRITH_HOME (default ~/.tirith) and TIRITH_PORT (default [server] port of config.toml, else 7717).
set -euo pipefail
ROOT=$(cd "$(dirname "$0")" && pwd)
HOME_DIR=${TIRITH_HOME:-$HOME/.tirith}
PORT=${TIRITH_PORT:-$(sed -n 's/^port *= *\([0-9]*\).*/\1/p' "$HOME_DIR/config.toml" 2>/dev/null | head -n 1)}
PORT=${PORT:-7717}
BIN="$ROOT/target/release/tirith"
command -v cargo >/dev/null || { echo "cargo not found: https://rustup.rs"; exit 1; }
cargo build -q --release -p tirith --manifest-path "$ROOT/Cargo.toml"
mkdir -p "$HOME_DIR/logs"
if curl -s -o /dev/null "http://127.0.0.1:$PORT/api/state"; then
    echo "Tirith is already running on port $PORT."
else
    nohup "$BIN" serve >>"$HOME_DIR/logs/tirithd.log" 2>&1 &
    for _ in $(seq 1 50); do curl -s -o /dev/null "http://127.0.0.1:$PORT/api/state" && break; sleep 0.1; done
    echo "Tirith started (log: $HOME_DIR/logs/tirithd.log)."
fi
open "http://127.0.0.1:$PORT/" 2>/dev/null || xdg-open "http://127.0.0.1:$PORT/" 2>/dev/null || echo "Open http://127.0.0.1:$PORT/"
