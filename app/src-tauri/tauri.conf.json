{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tirith",
  "version": "0.1.0",
  "identifier": "app.tirith.desktop",
  "build": {
    "frontendDist": "../../rust/tirith/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tirith",
    "category": "DeveloperTool",
    "shortDescription": "Tirith desktop app",
    "longDescription": "A window on the local tirith daemon: plan, agents, rules and the manager chat.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": { "section": "devel" },
      "rpm": { "release": "1" },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
