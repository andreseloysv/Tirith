#!/usr/bin/env bash
# `tirith` for agents: the collector CLI of this repo, run in the current folder.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
if ! command -v uv >/dev/null 2>&1; then
  # started without a login PATH (e.g. from the desktop app): look in the usual places
  PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.cargo/bin"
  export PATH
fi
exec uv run -q --project "$ROOT/collector" tirith "$@"
