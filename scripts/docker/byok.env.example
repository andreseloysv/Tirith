# Copilot CLI's BYOK settings for NeoBot: copy to the volume as /home/tirith/.tirith/auth/copilot.env (mode 0600).
# The key is the model provider's, never GitHub's. Do not put it in this file in the repository, and do not
# pass it as an argument: the README shows how it goes in through stdin.
COPILOT_OFFLINE=true
COPILOT_PROVIDER_TYPE=anthropic
COPILOT_PROVIDER_BASE_URL=https://api.anthropic.com
COPILOT_MODEL=<model>
# COPILOT_PROVIDER_API_KEY=<added by the first-start command, from stdin>
