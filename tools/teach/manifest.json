{
  "manifest_version": 3,
  "name": "Tirith · Enseñar",
  "version": "0.1.0",
  "description": "Records a task you do once (pages, clicks, typing) for one of your Tirith bots to learn it. Passwords, codes and cards are masked. Your bot rehearses the draft in its own tab, under a visible notice.",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tirith · Enseñar", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["mask.js", "content.js", "act.js"], "run_at": "document_idle" }
  ]
}
