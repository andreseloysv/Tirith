          "type": [
            "string",
            "null"
          ]
        },
        "hero_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "type": "integer",
          "minimum": 0
        },
        "present": {
          "type": "boolean"
        }
      }
