              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            }
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/room_message"
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "at",
        "from",
        "to",
        "from_name",
        "to_name",
        "kind",
        "text",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
