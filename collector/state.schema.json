          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "from_name": {
          "type": "string"
        },
        "to_name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "brief",
            "message",
            "report",
            "request",
            "answer",
            "decision",
            "merge",
            "alert"
          ]
        },
        "text": {
          "type": "string"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "why": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["input_tokens", "output_tokens", "cache_tokens", "cost_usd", "model", "turns",
                   "duration_s"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "model": {"type": ["string", "null"]},
        "turns": {"type": "integer", "minimum": 0},
        "duration_s": {"type": "integer", "minimum": 0}
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "size"],
      "properties": {
        "path": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "script": {"type": "string", "description": "Script next to state.js that defines the patch text for a file:// page."}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "started_at",
        "ended_at",
        "projects",
        "counts"
      ],
      "properties": {
        "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]},
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "agents",
            "pipelines",
            "flows",
            "notes"
          ],
          "properties": {
            "agents": {
              "type": "integer",
              "minimum": 0
            },
            "pipelines": {
              "type": "integer",
              "minimum": 0
            },
            "flows": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
