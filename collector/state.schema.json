        "status": {
          "type": "string",
          "enum": [
            "passed",
            "running",
            "failed",
            "pending",
            "skipped"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "log_tail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "html_url": {"type": ["string", "null"]}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "run",
        "project",
        "pipeline",
        "status",
        "started_at",
        "ended_at",
        "stages"
      ],
      "properties": {
        "run": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "pipeline": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "passed",
            "failed"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {"type": "string", "enum": ["github"]},
        "html_url": {"type": ["string", "null"]},
        "lane": {"type": ["string", "null"]},
        "worktree": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]}
      }
    },
    "room_message": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "n",
        "at",
        "from",
        "text",
        "re",
        "agreed",
        "signed",
        "kind",
        "truncated"
      ],
      "properties": {
        "n": {
          "type": "integer"
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "re": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "agreed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signed": {
          "enum": [
            "self",
            "platform",
            "none"
          ]
        },
        "kind": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
