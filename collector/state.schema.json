    "room_participant": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "kind",
        "hero_id",
        "hero_name",
        "last_seen",
        "messages",
        "present"
      ],
      "properties": {
        "name": {
          "type": "string"
