    "room": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "url",
        "title",
        "project",
        "summary",
        "summary_source",
        "needs_owner",
        "message_count",
        "last_message_at",
        "activity_per_hour",
        "messages_last_day",
        "polled_at",
        "error",
        "participants",
        "reply_edges",
        "messages"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary_source": {
          "enum": [
            "muse",
            "fallback",
            "none"
          ]
        },
        "needs_owner": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "n",
              "from",
              "reason",
              "source"
            ],
            "properties": {
              "n": {
                "type": "integer"
              },
              "from": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "brain",
                  "room"
                ]
              }
            }
          }
        },
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_message_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "activity_per_hour": {
          "type": "integer",
          "minimum": 0
        },
        "messages_last_day": {
          "type": "integer",
          "minimum": 0
        },
        "polled_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/room_participant"
          }
