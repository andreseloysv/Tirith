{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tirith/state/v1",
  "title": "Tirith state.json v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "generated_at",
    "brain",
    "manager",
    "waiting_on_you",
    "projects",
    "agents",
    "pipelines"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "brain": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "model",
        "last_error"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "steward": {"$ref": "#/properties/manager", "description": "Old key for manager, same value."},
    "manager": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "title",
        "activity",
        "since",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "activity": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "waiting_on_you": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wait"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "loose_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hook_event"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "rules": {
      "description": "Every active rule once, with what it blocked in the last 24 hours. See docs/CONTRACT-gates.md.",
      "type": "array",
      "items": {"$ref": "#/$defs/rule_summary"}
    },
    "inbox": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "at", "kind", "project", "step", "text", "status", "answers"],
        "properties": {
          "id": {"type": "string"},
          "at": {"type": ["string", "null"]},
          "kind": {"enum": ["finish", "ask", "setup", "chat"]},
          "manager_pending": {"type": "boolean"},
          "steward_pending": {"type": "boolean", "description": "Old key for manager_pending, same value."},
          "project": {"type": "string"},
          "step": {"type": "string"},
          "text": {"type": "string"},
          "status": {"enum": ["open", "answered", "done"]},
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["at", "by", "text", "auto"],
              "properties": {
                "at": {"type": ["string", "null"]},
                "by": {"enum": ["manager", "brain", "tirith"]},
                "text": {"type": "string"},
                "auto": {"type": "boolean"},
                "lane": {"type": ["string", "null"], "description": "Lane id of the agent that took the request."},
                "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
              }
            }
          },
          "lanes": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Lane ids handling the request: from answers[].lane and agents whose request_id matches."
          }
        }
      }
    },
    "models": {
      "description": "Model and effort of the manager and of the workers, with the lists the Settings page offers. See docs/CONTRACT-models.md.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "manager": {"type": "object", "additionalProperties": true},
        "workers": {"type": "object", "additionalProperties": true},
        "projects": {"type": "object", "additionalProperties": true},
        "steps": {"type": "object", "additionalProperties": true},
        "choices": {"type": "array", "items": {"type": "string"}},
        "efforts": {"type": "array", "items": {"type": "string"}},
        "agents": {"type": "array", "items": {"type": "string"}},
        "pending": {"type": "array", "items": {"type": "string"}}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": true,
      "required": ["token", "available"],
      "properties": {
        "token": {"type": ["string", "null"]},
        "available": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "setup": {
      "description": "Build, test, deploy, hooks and rules of a project. See docs/CONTRACT-setup.md.",
      "type": "object",
      "additionalProperties": true,
      "required": ["manifest", "check", "pipelines", "hooks", "rules", "gates_active"],
      "properties": {
        "manifest": {"type": ["string", "null"]},
        "check": {
          "type": "object",
          "additionalProperties": true,
          "required": ["ok", "problems"],
          "properties": {
            "ok": {"type": "boolean"},
            "problems": {"type": "array", "items": {
              "type": "object", "additionalProperties": true,
              "required": ["rule", "message", "fix"],
              "properties": {"rule": {"type": "string"}, "message": {"type": "string"},
                             "fix": {"type": "string"}, "line": {"type": "integer"}}}}
          }
        },
        "pipelines": {"type": "array", "items": {
          "type": "object", "additionalProperties": true, "required": ["id", "name", "stages"],
          "properties": {
            "id": {"type": "string"}, "name": {"type": "string"},
            "stages": {"type": "array", "items": {
              "type": "object", "additionalProperties": true, "required": ["name", "kind", "run", "last"],
              "properties": {
                "name": {"type": "string"},
                "kind": {"enum": ["build", "test", "deploy", null]},
                "run": {"type": ["string", "null"]},
                "last": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/setup_last"}]}}}}}}},
        "hooks": {"type": "array", "items": {
          "type": "object", "additionalProperties": true, "required": ["event", "run", "last"],
          "properties": {"event": {"type": "string"}, "run": {"type": "string"},
                         "last": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/setup_last"}]}}}},
        "rules": {"type": "array", "items": {
          "type": "object", "additionalProperties": true,
          "required": ["id", "label", "source", "enforced_by", "active", "description"],
          "properties": {
            "id": {"type": "string"}, "label": {"type": "string"},
            "source": {"enum": ["built-in", "tirith.toml"]},
            "enforced_by": {"type": "array", "items": {"enum": ["hook", "shim", "git", "lane run", "CI"]}},
            "active": {"type": "boolean"}, "description": {"type": "string"},
            "action": {"enum": ["block", "warn"]}}}},
        "gates_active": {"type": "boolean"},
        "gates_problems": {"type": "array", "items": {"type": "string"}},
        "gates_fix": {"type": "array", "items": {"type": "string"}},
        "pending": {"type": "array", "items": {
          "type": "object", "additionalProperties": true, "required": ["id", "at", "action", "summary"],
          "properties": {"id": {"type": "string"}, "at": {"type": ["string", "null"]},
                         "action": {"type": "string"}, "summary": {"type": "string"}}}}
      }
    },
    "setup_last": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "at", "duration_s", "run"],
      "properties": {
        "status": {"enum": ["passed", "failed", "running"]},
        "at": {"type": ["string", "null"]},
        "duration_s": {"type": ["integer", "null"]},
        "run": {"type": ["string", "null"]}
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ts", "rule", "agent", "lane", "project", "message"],
      "properties": {
        "ts": {"type": ["string", "null"]},
        "rule": {"type": "string"},
        "agent": {"type": ["string", "null"]},
        "lane": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "message": {"type": "string"},
        "blocked": {"type": "string"},
        "instead": {"type": "string"}
      }
    },
    "rule_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "description", "source", "count_24h", "last_at", "last_agent"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["built-in", "tirith.toml"]},
        "project": {"type": ["string", "null"]},
        "count_24h": {"type": "integer", "minimum": 0},
        "last_at": {"type": ["string", "null"]},
        "last_agent": {"type": ["string", "null"]}
      }
    },
    "hook_event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ts",
        "agent",
        "event",
        "summary"
      ],
      "properties": {
        "ts": {"type": "string"},
        "agent": {"type": "string"},
        "event": {"type": "string"},
        "lane": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]},
        "project": {"type": ["string", "null"]},
        "tool": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "agent_session_id": {"type": ["string", "null"]},
        "source": {"type": "string", "enum": ["hook", "log"]}
      }
    },
    "log_entry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["ts", "kind", "text", "detail"],
      "properties": {
        "ts": {"type": ["string", "null"]},
        "kind": {"type": "string",
                 "enum": ["say", "command", "output", "edit", "read", "error", "test", "spawn",
                          "done", "system"]},
        "text": {"type": "string"},
        "detail": {"type": "string", "maxLength": 4096},
        "fields": {"type": ["object", "null"]},
        "path": {"type": ["string", "null"]}
      }
    },
    "agent_file": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "change", "insertions", "deletions"],
      "properties": {
        "path": {"type": "string"},
        "change": {"type": "string",
                   "enum": ["added", "modified", "deleted", "renamed", "untracked"]},
        "insertions": {"type": "integer", "minimum": 0},
        "deletions": {"type": "integer", "minimum": 0}
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "at",
        "project",
        "text"
      ],
      "properties": {
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "command"],
      "description": "A command for the owner: a Run button (docs/CONTRACT-actions.md).",
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "command": {"type": "string"},
        "cwd": {"type": ["string", "null"]},
        "created_by": {"type": "string"},
        "at": {"type": ["string", "null"]},
        "last_run": {
          "type": ["object", "null"],
          "properties": {
            "status": {"enum": ["running", "passed", "failed"]},
            "exit_code": {"type": ["integer", "null"]},
            "at": {"type": ["string", "null"]},
            "log_tail": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "project",
        "text",
        "since",
        "link"
      ],
      "properties": {
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "id": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {"label": {"type": "string"}, "command": {"type": ["string", "null"]}}
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "brain",
            "guard",
            "room",
            "violation"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ok",
        "problems"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "nodes",
        "edges",
        "generated_at",
        "source"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "label",
              "kind",
              "files"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "files": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "from",
              "to",
              "label"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "muse",
            "manual",
            "none"
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "color",
        "architecture"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "architecture": {
          "$ref": "#/$defs/architecture"
        },
        "guard": {
          "$ref": "#/$defs/guard"
        },
        "folder": {
          "type": [
            "string",
            "null"
          ]
        },
        "auto": {
          "type": "boolean"
        },
        "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]},
        "setup": {"$ref": "#/$defs/setup"},
        "roadmap": {
          "description": "The project's plan read from its markdown checklist; null when there is none. See docs/CONTRACT-roadmap.md.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/roadmap"}]
        },
        "counts": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "agents_working",
            "agents_total",
            "pipelines_running",
            "flows_24h"
          ],
          "properties": {
            "agents_working": {
              "type": "integer",
              "minimum": 0
            },
            "agents_total": {
              "type": "integer",
              "minimum": 0
            },
            "pipelines_running": {
              "type": "integer",
              "minimum": 0
            },
            "flows_24h": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file", "deadline", "done", "total", "steps"],
      "properties": {
        "file": {"type": "string"},
        "deadline": {"type": ["string", "null"]},
        "done": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "title", "status", "done", "total", "items", "agents"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "status": {"enum": ["done", "active", "todo", "empty"]},
              "done": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "done"],
                  "properties": {"text": {"type": "string"}, "done": {"type": "boolean"}}
                }
              },
              "agents": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "project",
        "name",
        "epithet",
        "class",
        "rank",
        "renown",
        "feature",
        "status",
        "started_at",
        "ended_at",
        "elapsed_s",
        "summary",
        "log_tail",
        "files_changed",
        "insertions",
        "deletions",
        "report"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "Lane id of the agent that spawned this one, or 'manager'."
        },
        "review": {
          "type": ["object", "null"],
          "description": "Review and merge of a lane started by `tirith launch`; null for other lanes.",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["pending", "running", "tests-failed", "ready", "merge-failed", "merged"]},
            "at": {"type": "string"},
            "message": {"type": "string"}
          }
        },
        "step": {
          "type": ["string", "null"],
          "description": "Roadmap step id this lane works on (tirith lane run --step)."
        },
        "request_id": {
          "type": ["string", "null"],
          "description": "Inbox request this lane was started for (tirith lane run --request)."
        },
        "project": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "epithet": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "rank": {
          "type": "string",
          "enum": [
            "recruit",
            "sentinel",
            "sergeant",
            "captain",
            "marshal"
          ]
        },
        "renown": {
          "type": "integer",
          "minimum": 0
        },
        "feature": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "done",
            "failed",
            "stalled"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_s": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "log_tail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log_entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/log_entry"}
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_event"
          }
        },
        "goal": {"type": ["string", "null"]},
        "request": {
          "type": ["object", "null"],
          "properties": {
            "text": {"type": "string"},
            "at": {"type": "string"},
            "agent_session_id": {"type": "string"}
          }
        },
        "active": {"type": "boolean"},
        "last_activity_at": {"type": ["string", "null"]},
        "files": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/agent_file"}},
        "source": {"type": "string", "enum": ["github"]},
        "html_url": {"type": ["string", "null"]},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "count"],
            "properties": {"name": {"type": "string"},
                           "count": {"type": "integer", "minimum": 0}}
          }
        },
        "tests": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["at", "command", "result"],
            "properties": {
              "at": {"type": ["string", "null"]},
              "command": {"type": "string"},
              "full": {"type": "string"},
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "result": {"type": ["string", "null"],
                         "enum": ["passed", "failed", "running", null]}
            }
          }
        },
        "usage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/usage"}]},
        "ran": {
          "description": "The model and effort the lane was started with (docs/CONTRACT-models.md).",
          "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": true,
                    "properties": {"model": {"type": ["string", "null"]}, "effort": {"type": ["string", "null"]}}}]
        },
        "diff": {
          "description": "Full patch of the lane, stored at lane end (docs/CONTRACT-agents.md).",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/diff"}]
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "insertions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "status",
        "started_at",
        "ended_at",
        "duration_s",
        "log_tail"
