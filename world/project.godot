; Tirith — the 3D citadel. Godot 4.7, Forward+ renderer.
; The world is built in code from state.json; scenes/main.tscn is a thin shell.

config_version=5

[application]

config/name="Tirith"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/handling/input_files=null

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.62, 0.76, 0.9, 1)
anti_aliasing/quality/msaa_3d=2
